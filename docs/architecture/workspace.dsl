// Structurizr model for the architecture docs. The static export of the views below is
// generated by bin/structurizr-export.sh and embedded in docs/architecture/*.rst. Every
// view has an explicit key because the RST pages reference views by key.
workspace "Remote Settings" "Mozilla's service for shipping signed configuration data to Firefox and other client applications." {
    properties {
        "structurizr.introduction" "false"
    }

    model {
        autopush = softwareSystem "Autopush"
        firefox = softwareSystem "Firefox" {
            tags "WebBrowser"
        }
        remoteSettings = softwareSystem "Remote Settings" {
            writer = container "Writer" "Kinto with Remote Settings plugins." "Python / Kinto" {
                tags "Kinto"
            }
            settingsCdn = container "Remote Settings CDN" "Fastly CDN + WAF in front of reader" "Fastly" {
                tags "Fastly"
            }
            # https://github.com/mozilla/webservices-infra/blob/97178c8e8b4c8820af57f2c40112ba0b747e2853/remote-settings/tf/modules/remote_settings_infra/waf.tf#L9-L350
            attachmentsCdn = container "Attachments CDN" "Fastly in front of the GCS buckets." "Fastly" {
                tags "Fastly"
            }
            # https://github.com/mozilla/webservices-infra/blob/97178c8e8b4c8820af57f2c40112ba0b747e2853/remote-settings/tf/modules/remote_settings_infra/buckets.tf#L3
            gcsAttachments = container "Attachments bucket" "Uploaded attachments plus bundles" "GCS" {
                tags "Google Cloud Platform - Cloud Storage"
            }
            # https://github.com/mozilla/webservices-infra/blob/97178c8e8b4c8820af57f2c40112ba0b747e2853/remote-settings/tf/modules/remote_settings_infra/buckets.tf#L5
            # Despite the name, this bucket holds compressed attachments (.dcz) and manifest.json, not
            # dictionaries. The dictionaries are previous attachments, stored in gcsAttachments.
            gcsDictionaries = container "compression-dictionaries bucket" "Compressed attachments (.dcz) and a manifest.json per collection, under cdt/." "GCS" {
                tags "Google Cloud Platform - Cloud Storage"
            }
            cronjobs = container "Core cronjobs" "remote-settings-core-cronjobs image." "Python / k8s CronJob" {
                # https://github.com/mozilla/remote-settings/blob/main/cronjobs/src/commands/build_compression_dictionaries.py
                # Despite the name, this builds compressed attachments, not dictionaries.
                buildDictionaries = component "build_compression_dictionaries" "Builds .dcz versions of latest attachments using previous versions as dictionaries." "Cron Job"
            }
        }

        autopush -> settingsCdn "Checks for changes to collections"
        autopush -> firefox "Push notification for collection updates"
        firefox -> settingsCdn "Fetches changed collection"
        firefox -> attachmentsCdn "Fetches attachments"
        attachmentsCdn -> gcsAttachments "Serves attachments and bundles from"
        buildDictionaries -> writer "Fetch records with attachments in CDT-enabled collections"
        buildDictionaries -> gcsAttachments "Fetches the latest attachment and its previous versions (the dictionaries) to build missing .dcz files"
        buildDictionaries -> gcsDictionaries "Publishes .dcz files (latest attachment compressed using each previous version as the dictionary) and a manifest.json per collection"
        attachmentsCdn -> gcsDictionaries "Serves dictionary-compressed (.dcz) attachments from"
    }

    views {
        properties {
            # titles push canvases wide and shrink the contents most of the time
            "structurizr.title" "false"
            # remove generated timestamps from the views
            "structurizr.metadata" "false"
        }
        theme https://raw.githubusercontent.com/structurizr/themes/master/google-cloud-platform-v1.5/theme.json
        styles {
            element "Fastly" {
                icon icons/fastly.svg
            }
            element "Kinto" {
                icon icons/kinto.svg
            }
            element "WebBrowser" {
                shape WebBrowser
            }
        }

        dynamic remoteSettings "firefox-detects-updates" {
            title "Firefox detects updated collections"

            {
                {
                    autopush -> firefox "Push: collection changesets"
                }
                {
                    firefox -> settingsCdn "Fetches collection changesets (on startup, poll)"
                }
            }
            firefox -> settingsCdn "Fetch changed collections, emit 'sync'"
            autoLayout tb
        }

        dynamic remoteSettings "attachment-without-cdt" {
            title "Firefox requests attachment from collection without CDT enabled"

            # Assume not in local cache, so GET from CDN
            firefox -> attachmentsCdn "Consumer calls attachments.download(record)"
            attachmentsCdn -> gcsAttachments "Cache miss: fetch the full attachment and cache it"
            attachmentsCdn -> firefox "Full attachment returned to Firefox"
            autoLayout tb
        }

        dynamic remoteSettings "cdt-no-dictionary" {
            title "Firefox requests attachment from CDT-enabled collection (no dictionary available)"

            firefox -> attachmentsCdn "attachments.download(record): first download with CDT\nGET; Accept-Encoding: dcz, no Available-Dictionary"
            attachmentsCdn -> gcsAttachments "Cache miss: fetch the full attachment"
            attachmentsCdn -> firefox "Full attachment; Firefox stores it as this record's dictionary; Use-As-Dictionary"
            autoLayout tb
        }

        dynamic remoteSettings "cdt-compressed-available" {
            title "Firefox requests attachment from CDT-enabled collection (dictionary available, compressed attachment available)"

            firefox -> attachmentsCdn "attachments.download(record); Accept-Encoding: dcz, Available-Dictionary, Dictionary-ID"
            attachmentsCdn -> gcsDictionaries "Cache miss: fetch the .dcz built from Firefox's dictionary"
            gcsDictionaries -> attachmentsCdn "Compressed attachment; CDN checks it was built from Firefox's dictionary\n200; x-goog-meta-source_sha256"
            attachmentsCdn -> firefox "Compressed attachment; once decoded, the new attachment becomes the next dictionary\n200; Content-Encoding: dcz, Use-As-Dictionary"
            autoLayout tb
        }

        dynamic remoteSettings "cdt-compressed-unavailable" {
            title "Firefox requests attachment from CDT-enabled collection (dictionary available, compressed attachment unavailable)"

            firefox -> attachmentsCdn "attachments.download(record)\nGET; Accept-Encoding: dcz, Available-Dictionary, Dictionary-ID"
            attachmentsCdn -> gcsDictionaries "Cache miss: fetch the .dcz built from Firefox's dictionary"
            gcsDictionaries -> attachmentsCdn "No .dcz for this dictionary, or built from different content\n404, or source_sha256 mismatch"
            attachmentsCdn -> gcsAttachments "Restart once: fetch the full attachment"
            attachmentsCdn -> firefox "Full attachment, advertised as the next dictionary; Use-As-Dictionary"
            autoLayout tb
        }

        dynamic cronjobs "build-compressed-attachments" {
            title "Remote Settings builds compressed attachments"

            buildDictionaries -> writer "Determine attachments that need to be compressed"
            buildDictionaries -> gcsAttachments "Fetch latest attachments and their previous versions (dictionaries)"
            buildDictionaries -> gcsDictionaries "Upload compressed attachments (.dcz) and manifest.json"
            autoLayout tb
        }
    }
}
